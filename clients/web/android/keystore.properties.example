# Copy to keystore.properties and fill in. NEVER commit the real file.
#
# Create the keystore first (run it from this directory):
#
#   keytool -genkeypair -v -keystore nexus-release.jks -alias nexus \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# BACK THE .jks FILE UP OFF THIS MACHINE. It is the identity Google Play ties the listing to;
# lose it and the app can never be updated under the same package name again.

storeFile=nexus-release.jks
storePassword=CHANGE_ME
keyAlias=nexus
keyPassword=CHANGE_ME
